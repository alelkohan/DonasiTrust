APP_NAME=DonasiTrust
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (MySQL: Laragon / XAMPP / Herd) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=donasitrust
DB_USERNAME=root
DB_PASSWORD=

# Untuk mencoba cepat tanpa MySQL, ganti dua baris di atas jadi:
# DB_CONNECTION=sqlite
# (lalu jalankan: touch database/database.sqlite)

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@donasitrust.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- DonasiTrust ---
# Secret untuk kode verifikasi kuitansi (HMAC-SHA256). WAJIB diganti di produksi.
DONASI_RECEIPT_SECRET=ganti-dengan-string-acak-panjang-di-produksi

# Gateway pembayaran: "mock" (simulasi lokal) atau "midtrans"
PAYMENT_GATEWAY=midtrans
MOCK_WEBHOOK_TOKEN=demo-webhook-token
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# --- Google OAuth (Socialite) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Biaya operasional platform (persen dari donasi). 0 = tanpa potongan.
PLATFORM_FEE_PERCENT=0

VITE_APP_NAME="${APP_NAME}"
